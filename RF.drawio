        <mxCell id="DiWK4chBAIH79hT7bcEi-2" value="PLL lock&lt;div&gt;&amp;lt; 130µS&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="520" width="120" height="40" as="geometry" />
